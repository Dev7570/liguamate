# ─── LinguaMate AI ───────────────────────────────────────────
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://linguamate:linguamate@localhost:5432/linguamate
SYNC_DATABASE_URL=postgresql://linguamate:linguamate@localhost:5432/linguamate

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Auth ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ─── App ─────────────────────────────────────────────────────
APP_NAME=LinguaMate AI
DEBUG=true
FRONTEND_URL=http://localhost:5173
